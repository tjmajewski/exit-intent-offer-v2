/extensions/*/dist

# Ignore shopify files created during app dev
.shopify/*
.shopify.lock

# Hide files auto-generated by react router
.react-router/
# Local working directories — marketing drafts and Claude Code session state.
# Untracked and bulky (instagram-drafts is ~6MB of PNGs); listed here so a
# `git add -A` during a code change cannot sweep them into a commit.
instagram-drafts/
linkedin-drafts/
.claude/*
# Batman is versioned with the code it drives. The pattern above ignores the
# contents rather than the directory itself, because git will not descend into
# an excluded directory and a negation under one can never match.
!.claude/skills/


# Prospect scan output (regenerated, not source)
prospecting/out/
prospecting/node_modules/
